# Telegram Bot Integration
TELEGRAM_BOT_TOKEN="your_bot_token"
TELEGRAM_CHAT_ID="your_chat_id"

# SMTP Email Dispatch
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_FROM="user@example.com"
SMTP_TO="manager@electromax.com"

# Turnstile/ReCaptcha (Optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# SEO
NEXT_PUBLIC_SITE_URL="https://electromax.vercel.app"

# Leads mode for first Vercel deploy
NEXT_PUBLIC_LEADS_MODE="mock"

# Revalidation
REVALIDATE_SECRET=""

# CMS (first Vercel release should keep CMS disabled)
CMS_ENABLED="false"
CMS_BASE_URL=""
CMS_USE_PAYLOAD_LOCAL_API="false"

# CMS-only values for later activation
PAYLOAD_SECRET="your_payload_secret_here"
DATABASE_URI="postgresql://user:password@host:port/dbname"

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_CONSENT_MODE="consent-first"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_API_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"

# Yandex Metrika
NEXT_PUBLIC_YANDEX_METRIKA_ID=""
NEXT_PUBLIC_YANDEX_METRIKA_GOAL_LEAD_FORM="lead_form_submitted"
NEXT_PUBLIC_YANDEX_METRIKA_WEBVISOR="true"

# Optional security salts
ANALYTICS_IP_HASH_SALT=""
REVALIDATE_IP_HASH_SALT=""
