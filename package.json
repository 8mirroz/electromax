{
  "name": "electromax",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "content:sync": "npx tsx scripts/content/import-services-xlsx.ts",
    "content:generate:drafts": "node scripts/content-gen/generate-drafts.mjs",
    "content:localize:drafts": "node scripts/content-gen/localize-drafts.mjs",
    "content:validate:drafts": "node scripts/content-gen/validate-drafts.mjs",
    "content:qa": "promptfoo eval -c promptfoo/promptfooconfig.yaml",
    "db:seed": "npx tsx scripts/content/seed-payload.ts",
    "cms:seed:fallback": "pnpm tsx scripts/content/seed-payload-from-fallback.ts",
    "analytics:synthetic": "node scripts/analytics/send-synthetic-events.mjs",
    "ops:verify:stage12": "node scripts/ops/verify-stage12.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.4.2",
    "@payloadcms/db-postgres": "^3.78.0",
    "@payloadcms/next": "^3.78.0",
    "@payloadcms/richtext-lexical": "^3.78.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "focus-trap-react": "^12.0.0",
    "framer-motion": "^12.34.3",
    "graphql": "^16.13.0",
    "gsap": "^3.14.2",
    "lucide-react": "^0.575.0",
    "motion": "^12.34.3",
    "next": "16.1.6",
    "nodemailer": "^8.0.1",
    "payload": "^3.78.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.33",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "promptfoo": "^0.120.25",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,mdx,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
